// Retail IQ — Indian Store Data metric dictionary (Migration Addendum v2.0 §4)
// marts.revenue_daily[revenue] is the governed daily SUM(curated.orders.sales).
// Mark the Date table as the model's date table and relate Date[Date] 1:* to
// each date-grained mart using single-direction filtering.

Date =
CALENDAR (
    MIN ( revenue_daily[date] ),
    MAX ( revenue_daily[date] )
)

Revenue =
SUM ( revenue_daily[revenue] )

Profit =
SUM ( revenue_daily[total_profit] )

Profit Margin =
DIVIDE ( [Profit], [Revenue] )

Total Orders =
SUM ( revenue_daily[order_count] )

AOV =
DIVIDE ( [Revenue], [Total Orders] )

Avg Discount =
DIVIDE (
    SUMX (
        revenue_daily,
        revenue_daily[avg_discount_pct] * revenue_daily[order_count]
    ),
    [Total Orders]
)

Customer Count =
SUM ( revenue_daily[customer_count] )

// Use Customer Count only where the date context cannot double-count a
// customer. The migrated source has one order per customer, but this note keeps
// the measure honest if a future refresh introduces repeat customers.

Previous Month Revenue =
CALCULATE ( [Revenue], DATEADD ( 'Date'[Date], -1, MONTH ) )

Revenue MoM Growth % =
DIVIDE ( [Revenue] - [Previous Month Revenue], [Previous Month Revenue] )

Previous Year Revenue =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

Revenue YoY Growth % =
DIVIDE ( [Revenue] - [Previous Year Revenue], [Previous Year Revenue] )

Category Revenue =
SUM ( revenue_by_category[revenue] )

Category Profit =
SUM ( revenue_by_category[total_profit] )

Regional Revenue =
SUM ( revenue_by_region[revenue] )

Regional Profit =
SUM ( revenue_by_region[total_profit] )
