{
  "name": "retail-iq-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "format": "prettier --write app components lib scripts src/generated/api tailwind.config.ts postcss.config.js",
    "format:check": "prettier --check app components lib scripts src/generated/api tailwind.config.ts postcss.config.js",
    "generate:api": "openapi --input http://localhost:8000/api/v1/openapi.json --output src/generated/api --client fetch --useOptions --useUnionTypes && prettier --write src/generated/api"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "leaflet": "1.9",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.85.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/leaflet": "1.9",
    "@types/node": "22.15.29",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "^10.5.4",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "openapi-typescript-codegen": "^0.29.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
